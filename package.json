{
  "name": "nuxt-b-bookmarker-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:migrate": "NODE_ENV=development ts-node -O '{\"module\":\"commonjs\"}' ./node_modules/.bin/sequelize db:migrate --config server/db/config.js --migrations-path server/db/migrations",
    "db:migrate:undo": "NODE_ENV=development ts-node -O '{\"module\":\"commonjs\"}' ./node_modules/.bin/sequelize db:migrate:undo --config server/db/config.js --migrations-path server/db/migrations",
    "db:migrate:undo:all": "NODE_ENV=development ts-node -O '{\"module\":\"commonjs\"}' ./node_modules/.bin/sequelize db:migrate:undo:all --config server/db/config.js --migrations-path server/db/migrations",
    "db:seed": "NODE_ENV=development ts-node -O '{\"module\":\"commonjs\"}' ./node_modules/.bin/sequelize db:seed:all --config server/db/config.js --seeders-path server/db/seeders",
    "db:seed:undo": "NODE_ENV=development ts-node -O '{\"module\":\"commonjs\"}' ./node_modules/.bin/sequelize db:seed:undo:all --config server/db/config.js --seeders-path server/db/seeders"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.74",
    "@iconify-json/simple-icons": "^1.2.59",
    "@nuxt/ui": "^4.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^4.2.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/sequelize": "^4.28.20",
    "eslint": "^9.39.1",
    "sequelize-cli": "^6.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.5"
  },
  "packageManager": "pnpm@10.23.0"
}
