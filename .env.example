# ================================
# APP CONFIG
# ================================
NODE_ENV=development
APP_NAME=nuxt-b-bookmarker-app
APP_URL=http://localhost:3001
APP_PORT=3001


# ================================
# DATABASE CONFIG (POSTGRESQL)
# ================================
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=b_bookmarker_db
DB_USERNAME=postgres
DB_PASSWORD=postgres


# ================================
# SEQUELIZE CONFIG
# ================================
DB_LOGGING=false
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000


# ================================
# JWT CONFIG
# ================================
JWT_SECRET=NUXT_B_ET_SUPER_SECRET_KEY_2025
JWT_EXPIRES_IN=1d
JWT_ISSUER=nuxt-b-bookmarker-app


# ================================
# PASSWORD HASH CONFIG
# ================================
BCRYPT_SALT_ROUNDS=10


# ================================
# CORS CONFIG
# ================================
CORS_ORIGIN=http://localhost:3001
CORS_METHODS=GET,POST,PUT,PATCH,DELETE


# ================================
# LOGGING & DEBUG
# ================================
DEBUG=true
ENABLE_QUERY_LOG=false


# ================================
# OPTIONAL (FOR PRODUCTION)
# ================================
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
